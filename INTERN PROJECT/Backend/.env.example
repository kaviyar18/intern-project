# Choose: gemini or openai (used by services/llm_service.py)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional OpenAI-compatible assistant_service configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional frontend origins, comma-separated
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000

# Optional CSV override; default is data/schemes.csv
# SCHEMES_CSV_PATH=
